PORT=3000
HOST=0.0.0.0
APP_URL=http://localhost:3000
NODE_ENV=local
FE_ALLOWED_URL=http://localhost:3001

# secret
JWT_SECRET_KEY=string
EXPRESS_SESSION_SECRET=string

# google
GOOGLE_CLIENT_ID=string

# redis
REDIS_URL=rediss://username:password@host:port
REDIS_KEY_PREFIX=thanhfng_server

# db
MONGODB_TABLE_NAME=prefix_
MONGODB_URL=mongodb+srv://user:password@host/database

# paypal
PAYPAL_CLIENT_ID=string
PAYPAL_CLIENT_SECRET=string
PAYPAL_WEBHOOK_ID=string
PAYPAL_MODE=sandbox

# --- Crypto Payment (BNB Testnet) ---
# Set CRYPTO_PAYMENT_ENABLED=true to enable on-chain crypto payments
# CRYPTO_PAYMENT_ENABLED=false
# BNB_RPC_URL=https://data-seed-prebsc-1-s1.binance.org:8545
# NGOO_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_CONTRACT_ADDRESS
# NGOO_CHAIN_ID=97
# NGOO_SIGNER=0xYOUR_SIGNER_PRIVATE_KEY

# Crypto payment tuning (optional, shown with defaults)
# CRYPTO_PROOF_TTL_SEC=900
# CRYPTO_BLOCK_CONFIRMATIONS=5
# CRYPTO_PRICE_CACHE_TTL_SEC=60
# CRYPTO_MONITOR_POLL_INTERVAL_MS=15000
# CACHE_CRYPTO_PROOF_TTL_SEC=900
# LOCK_CRYPTO_PAYMENT_TTL_MS=60000 (raised from 30s to cover slow DB operations)

# --- Logging ---
LOG_LEVEL=info

# --- Queue ---
# QUEUE_MAX_CONCURRENT=10
# QUEUE_MAX_RETRIES=3
# QUEUE_RETRY_DELAY_MS=1000
# QUEUE_MAX_RETRY_DELAY_MS=30000
# QUEUE_STALLED_TIMEOUT_MS=30000

# --- Rate Limiting ---
# RATE_LIMIT_ORDER_BUCKET_SIZE=5
# RATE_LIMIT_ORDER_REFILL_RATE=1
# RATE_LIMIT_ORDER_INTERVAL_SEC=60
# RATE_LIMIT_PAYMENT_BUCKET_SIZE=3
# RATE_LIMIT_PAYMENT_REFILL_RATE=1
# RATE_LIMIT_PAYMENT_INTERVAL_SEC=300
# RATE_LIMIT_AUTH_BUCKET_SIZE=10
# RATE_LIMIT_AUTH_REFILL_RATE=1
# RATE_LIMIT_AUTH_INTERVAL_SEC=60
# RATE_LIMIT_ADMIN_BUCKET_SIZE=30
# RATE_LIMIT_ADMIN_REFILL_RATE=5
# RATE_LIMIT_ADMIN_INTERVAL_SEC=60

# --- Cache TTLs (seconds) ---
# CACHE_DEFAULT_TTL_SEC=3600
# CACHE_ORDER_CHECKOUT_TTL_SEC=900 (raised from 180 to match PayPal's 15-min approval window)
# CACHE_ORDER_LIMIT_PROCESSING_TTL_SEC=120
# CACHE_ORDER_LIMIT_ATTEMPT_TTL_SEC=600
# CACHE_PAYPAL_STATUS_TTL_SEC=300
# CACHE_PAYPAL_WEBHOOK_IDEMPOTENCY_TTL_SEC=604800

# --- Lock TTLs (milliseconds) ---
# LOCK_PAYMENT_TTL_MS=60000 (raised from 30s to cover slow DB operations)
# LOCK_WEBHOOK_PROCESSING_TTL_MS=60000

# --- JWT ---
# JWT_ACCESS_TOKEN_EXP=60m
# JWT_REFRESH_TOKEN_EXP=30d

# --- MongoDB ---
# MONGODB_MAX_POOL_SIZE=20
# MONGODB_MIN_POOL_SIZE=5
# MONGODB_MAX_IDLE_TIME_MS=30000
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000

# --- PayPal Service ---
# PAYPAL_CLIENT_TIMEOUT_MS=30000
# PAYPAL_WEBHOOK_TIMEOUT_MS=10000

# --- Payment ---
# PAYMENT_DEFAULT_EXPIRY_MS=600000

# --- Session ---
# SESSION_COOKIE_MAX_AGE_SEC=86400
# REQUEST_BODY_LIMIT=1mb
